# Variables d'environnement de PlaniLux (exemple sans secret — à copier en .env.local)
# Valeurs à copier depuis Supabase → Project Settings → API (ou « Connect »).

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clé publique (« publishable », sb_publishable_…) ou clé « anon » : conçue pour être visible dans le navigateur,
# sans danger SEULEMENT parce que la sécurité par ligne (RLS) est activée sur les tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Ne JAMAIS mettre ici : mot de passe de base de données, clé service_role / sb_secret_…, jeton Vercel ou GitHub.
