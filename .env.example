# Variables d'environnement de PlaniLux (exemple sans secret — à copier en .env.local)
# Valeurs à copier depuis Supabase → Project Settings → API (ou « Connect »).

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clé publique (« publishable », sb_publishable_…) ou clé « anon » : conçue pour être visible dans le navigateur,
# sans danger SEULEMENT parce que la sécurité par ligne (RLS) est activée sur les tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Clé d'administration Supabase (strictement serveur, JAMAIS de préfixe NEXT_PUBLIC_)
# Requise pour la suppression définitive de compte (auth.admin.deleteUser) et la lecture serveur des flux calendriers
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Clé secrète dédiée pour la signature HMAC des jetons de partage de calendrier (ICS/webcal)
# Clé aléatoire robuste conservée strictement côté serveur
CALENDAR_SIGNING_SECRET=generate_a_random_32_bytes_hex_secret_here
